# Runtime
NODE_ENV=development
PREVIEW_LOG_LEVEL=info

# Hosted persistence (not required for Gate 0 kernel tests)
DATABASE_URL=postgresql://preview:preview@localhost:5432/preview

# Model orchestration (required starting at Gate 3; never commit a real value)
OPENAI_API_KEY=

