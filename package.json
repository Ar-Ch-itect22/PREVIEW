{
  "name": "preview",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm build && pnpm typecheck:packages && pnpm test:packages",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm build && pnpm test:packages",
    "test:gate1": "pnpm build && pnpm --filter @preview/reference-calendar test",
    "test:gate2": "pnpm build && pnpm --filter @preview/reference-mail test",
    "test:gate3": "pnpm build && pnpm --filter @preview/agent-openai test",
    "test:gate3:live": "pnpm build && node --env-file=.env packages/agent-openai/dist/live-gate-three.js",
    "test:gate4": "pnpm build && pnpm --filter @preview/customer-ops-demo test",
    "test:gate6": "pnpm build && pnpm --filter @preview/customer-ops-demo exec vitest run test/gate-six.test.ts",
    "test:packages": "pnpm -r --if-present test",
    "test:unit": "pnpm build && pnpm --filter @preview/domain test",
    "typecheck": "pnpm build && pnpm typecheck:packages",
    "typecheck:packages": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.15",
    "eslint": "^9.31.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
